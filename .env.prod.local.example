# Copy to .env.prod.local, fill in, then run ./scripts/split-to-prod.sh
#
# .env.prod.local is git-ignored (.env*). DELETE IT once the split is done —
# it holds the production DB password and the admin password.

# ── the NEW Supabase project (Dashboard → Project Settings → API) ────────────
NEXT_PUBLIC_SUPABASE_URL="https://NEWREF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="new-anon-or-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="new-service-role-or-secret-key"
SUPABASE_PROJECT_ID="NEWREF"
SUPABASE_DB_PASSWORD="the-db-password-you-set-when-creating-the-project"
SUPABASE_ENV="production"

# ── app ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://crimson-creed-dashboard.vercel.app"

# ── the one real Super Admin to create in production ────────────────────────
ADMIN_EMAIL="you@example.com"
ADMIN_USERNAME="your_handle"
ADMIN_NAME="Your Name"
ADMIN_RANK="BOSS"
ADMIN_PASSWORD="a-strong-password-at-least-8-chars"
