# ─── Supabase ─────────────────────────────────────────────────────────────────
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Server-only. Never exposed to the browser. Used for admin operations that the
# PRD assigns to Super Admin: creating member auth users and resetting member
# passwords (PRD §4). Also used by the seed script.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Local Supabase CLI link (optional, for `supabase db push` / `db:types`):
# SUPABASE_PROJECT_ID="YOUR-PROJECT-ref"
# SUPABASE_DB_PASSWORD="your-db-password"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── FiveM live monitor ───────────────────────────────────────────────────────
# The monitor reads the game server's public endpoints (game port, usually
# :30120) through /api/fivem. Where it reads from is resolved in this order:
#
#   1. the `fivem_uplink` row in the database   ← the normal case
#   2. FIVEM_SERVER_URL below
#   3. the reference server built into the code
#
# The reference server (Jakarta, AS131745) black-holes datacenter traffic: it
# answers Indonesian residential connections in ~30ms and ignores Vercel from
# every region, on both http and https. A deployment therefore cannot read it
# directly — the request has to originate from a network the server will talk
# to. On such a machine, run:
#
#   node tools/fivem-uplink.mjs
#
# That starts the relay, opens a tunnel, and publishes the tunnel's CURRENT url
# to `fivem_uplink`, re-publishing on a heartbeat. A hostname that changes on
# every restart is then picked up within seconds and nothing here needs editing
# and no redeploy is needed. Pinning a tunnel URL in FIVEM_SERVER_URL is the old
# manual arrangement that broke on every reboot; the database value overrides it,
# so a stale one left behind here does no harm.
#
# Leave unset for local development on a network that reaches the game server.
# FIVEM_SERVER_URL="https://main.imeroleplay.com:30120"

# The address players JOIN — the header text and the fivem://connect/ link.
# Defaults to whatever we read from, except when reading through the uplink,
# where it falls back to the game server, since a tunnel hostname is not
# joinable. Only set this if the game server itself moves.
# FIVEM_PUBLIC_HOST="main.imeroleplay.com:30120"
