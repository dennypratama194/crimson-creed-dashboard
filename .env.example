# ─── Supabase ─────────────────────────────────────────────────────────────────
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Server-only. Never exposed to the browser. Used for admin operations that the
# PRD assigns to Super Admin: creating member auth users and resetting member
# passwords (PRD §4). Also used by the seed script.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Local Supabase CLI link (optional, for `supabase db push` / `db:types`):
# SUPABASE_PROJECT_ID="YOUR-PROJECT-ref"
# SUPABASE_DB_PASSWORD="your-db-password"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── FiveM live monitor ───────────────────────────────────────────────────────
# Where the monitor READS from (game port, usually :30120). Server-only, proxied
# by /api/fivem; defaults to the reference server when unset. Both schemes are
# tried in parallel and the first to answer wins.
#
# The reference server (Jakarta, AS131745) black-holes datacenter traffic: it
# answers Indonesian residential connections in ~50ms and ignores Vercel from
# every region, on both http and https. So a deployment cannot read it directly
# — run `node tools/fivem-relay.mjs` on a machine that CAN reach it, expose that
# with a tunnel, and point this at the tunnel URL.
FIVEM_SERVER_URL="https://main.imeroleplay.com:30120"

# The address players JOIN — the header text and the fivem://connect/ link.
# Only needed when FIVEM_SERVER_URL points at a relay, since a tunnel hostname
# is not joinable. Defaults to the host of FIVEM_SERVER_URL.
# FIVEM_PUBLIC_HOST="main.imeroleplay.com:30120"
