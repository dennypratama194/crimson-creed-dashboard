# ─── Supabase ─────────────────────────────────────────────────────────────────
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Server-only. Never exposed to the browser. Used for admin operations that the
# PRD assigns to Super Admin: creating member auth users and resetting member
# passwords (PRD §4). Also used by the seed script.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Local Supabase CLI link (optional, for `supabase db push` / `db:types`):
# SUPABASE_PROJECT_ID="YOUR-PROJECT-ref"
# SUPABASE_DB_PASSWORD="your-db-password"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── FiveM live monitor ───────────────────────────────────────────────────────
# /api/fivem tries the server's own HTTP port first (real player names), and
# falls back to the Cfx.re master list (anonymised "AnonN" names) when that
# times out — which it does from datacenter IPs like Vercel. Both server-only.
#
# Direct endpoint (game port). Defaults to the reference server when unset:
FIVEM_SERVER_URL="http://main.imeroleplay.com:30120"
# Join code for the master-list fallback. Defaults to the reference server:
FIVEM_JOIN_CODE="zrvmg4"
